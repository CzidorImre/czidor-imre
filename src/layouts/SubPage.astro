---
// Shell for the town and guide pages: same header, contact block and footer
// as the main page, with section links pointing back to "/".
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import FloatingUI from '../components/FloatingUI.astro';

export interface Props {
  title: string;
  description: string;
  /** Last breadcrumb label (the page itself). */
  crumb: string;
  jsonLd?: object[];
}

const { title, description, crumb, jsonLd = [] } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL('/', Astro.site).href;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Főoldal', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: crumb, item: pageUrl },
  ],
};
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
    <script type="application/ld+json" set:html={JSON.stringify([...jsonLd, breadcrumb])} />
  </Fragment>

  <a href="#main" class="skip">Ugrás a tartalomhoz</a>

  <Header base="/" />

  <main id="main">
    <slot />
    <Contact />
  </main>

  <Footer base="/" />
  <FloatingUI />

  <script is:inline src="/site.js"></script>
</BaseLayout>
