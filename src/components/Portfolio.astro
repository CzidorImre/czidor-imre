---
// 06 — References. Featured project + filter pills + project grid.
// Rendered at build time; client-side filter handled by /site.js.
import { projects, catLabel, roleLabel } from '../data/projects';

const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="section alt" id="referenciak">
  <div class="wrap">
    <div class="shead">
      <div class="rv">
        <h2>Főbb referenciák</h2>
      </div>
      <p class="lead rv rv-d1">Több mint 30 projekt 2003 óta. Családi házak, társasházak, bankfiókok, ipari parkok, nagyüzemi beruházások.</p>
    </div>

    <!-- Featured project -->
    <article class="feat rv">
      <div class="feat-main">
        <span class="mono k">Kiemelt referencia</span>
        <h3>Birla Carbon Hungary, 4. gyártósor technológiai alapozása</h3>
        <p>Nehézipari technológiai alapozás Tiszaújvárosban, felelős műszaki vezetői szerepkörben, feszített ütemtervvel és kritikus geometriai tűréshatárokkal. A projekt komplexitása és léptéke a régió egyik meghatározó ipari beruházása.</p>
        <div class="feat-tags">
          <span>Ipari létesítmény</span>
          <span>Felelős műszaki vezetés</span>
          <span>Nehézipar</span>
        </div>
      </div>
      <div class="feat-side">
        <div class="big" aria-hidden="true">2024–25</div>
        <dl class="feat-dl">
          <div><dt>Helyszín</dt><dd>Tiszaújváros</dd></div>
          <div><dt>Szerep</dt><dd>Felelős műsz. vez.</dd></div>
          <div><dt>Kategória</dt><dd>Ipari</dd></div>
          <div><dt>Státusz</dt><dd>Átadva</dd></div>
        </dl>
      </div>
    </article>

    <!-- Filter buttons -->
    <div class="filters rv" role="group" aria-label="Kategória szűrő">
      <button class="fbtn act" data-f="all" aria-pressed="true">Összes</button>
      <button class="fbtn" data-f="lakoepuletek" aria-pressed="false">Lakóépületek</button>
      <button class="fbtn" data-f="kozepuletek" aria-pressed="false">Középületek</button>
      <button class="fbtn" data-f="ipari" aria-pressed="false">Ipari létesítmények</button>
      <button class="fbtn" data-f="bank" aria-pressed="false">Bank és iroda</button>
    </div>

    <!-- Project grid -->
    <div class="proj-grid" id="proj-grid">
      {projects.map((p, i) => (
        <article class="card proj" data-cat={p.cat}>
          <div class="proj-head">
            <span class="yr">{p.year}</span>
            <span class="cat">{catLabel[p.cat]}</span>
          </div>
          <h3>{p.title}</h3>
          <div class="loc">{p.town}</div>
          {p.desc && <p>{p.desc}</p>}
          <div class="foot">
            <span class="role-t">{roleLabel[p.role]}</span>
            <span class="idx">N° {pad(projects.length - i)}</span>
          </div>
        </article>
      ))}
    </div>
    <button type="button" class="btn btn-ghost proj-more" id="proj-more" aria-controls="proj-grid">Mind a {projects.length} referencia <span aria-hidden="true">↓</span></button>
  </div>
</section>
