---
// Top of a guide page: breadcrumb, H1, lead and the two CTAs.
import { QUOTE_MAILTO } from '../lib/quote';

const { h1, lead, crumb } = Astro.props as { h1: string; lead: string; crumb: string };
---
<section class="town-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Morzsamenü"><a href="/">Főoldal</a><span aria-hidden="true">/</span><span>Tudnivalók</span><span aria-hidden="true">/</span><span>{crumb}</span></nav>
    <h1>{h1}</h1>
    <p class="sub">{lead}</p>
    <div class="cta-row">
      <a href={QUOTE_MAILTO} class="btn btn-primary">Ajánlatkérés <span class="arr" aria-hidden="true">→</span></a>
      <a href="#kapcsolat" class="btn btn-ghost">Elérhetőségek</a>
    </div>
  </div>
</section>
