---
// 03 — How I work: the inspector's four steps, contract to occupancy.
const pad = (n: number) => String(n).padStart(2, '0');

const steps: [string, string][] = [
  ['Szerződés és költségvetés felülvizsgálata', 'Még a munkakezdés előtt átnézem a kivitelezői ajánlatokat, a vállalkozási szerződést és a költségvetést, hogy a rejtett kockázatok és a hátrányos feltételek időben kiderüljenek.'],
  ['Munkakezdés és e-napló', 'Készenlétbe helyezem az elektronikus építési naplót, és dokumentáljuk a munkaterület átadását, így a kivitelezés az első naptól nyomon követhető.'],
  ['Folyamatos helyszíni ellenőrzés', 'Rendszeresen a helyszínen vagyok: ellenőrzöm az eltakarásra kerülő szerkezeteket, a tervnek és a szerződésnek való megfelelést, és csak az elvégzett munkát igazolom le.'],
  ['Átadás-átvétel és használatbavétel', 'Levezetem a műszaki átadás-átvételt, jegyzékbe veszem a hibákat és hiányosságokat, és ellenőrzöm a pótlásukat egészen a használatbavételig.'],
];
---
<section class="section alt" id="folyamat">
  <div class="wrap proc-grid">
    <div class="proc-head rv">
      <h2>Hogyan dolgozom</h2>
      <p class="lead">Műszaki ellenőrként a szerződéskötéstől a használatbavételig minden szakaszban az Ön oldalán állok.</p>
    </div>
    <ol class="proc">
      {steps.map(([t, d], i) => (
        <li class="proc-step rv">
          <span class="proc-n mono">{pad(i + 1)}</span>
          <div><h3>{t}</h3><p>{d}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
