---
// Fixed/floating UI: mobile call bar, back-to-top, cookie consent bar.
// Behaviour (show/hide, localStorage consent) is in /site.js.
import PhoneReveal from './PhoneReveal.astro';
---
<!-- mobile click-to-call bar -->
<div class="callbar" id="callbar" aria-label="Gyors elérhetőség">
  <PhoneReveal buttonClass="callbar-btn call" linkClass="callbar-btn call" label="Hívás" ariaLabel="Telefonszám megjelenítése a híváshoz" icon={18} />
  <a href="#kapcsolat" class="callbar-btn quote">Ajánlatkérés</a>
</div>

<!-- back to top -->
<button class="totop" id="totop" type="button" aria-label="Vissza a tetejére"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>

<!-- cookie / consent bar -->
<div class="cookie" id="cookie" role="dialog" aria-label="Süti beállítások" hidden>
  <p>A működéshez szükséges helyi tároláson felül – az Ön hozzájárulásával – névtelen látogatói statisztikát (Microsoft Clarity) használunk az oldal fejlesztéséhez. Marketing sütiket nem alkalmazunk. <a href="/adatvedelem/" class="lu">Részletek</a></p>
  <div class="cookie-actions">
    <button type="button" id="cookie-no" class="btn btn-ghost">Elutasítom</button>
    <button type="button" id="cookie-ok" class="btn btn-primary">Elfogadom</button>
  </div>
</div>
